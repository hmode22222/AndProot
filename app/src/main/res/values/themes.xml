<resources xmlns:tools="http://schemas.android.com/tools">
  <style name="Base.AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
    <item name="android:windowBackground">@color/terminal_bg</item>
    <item name="android:statusBarColor">@color/terminal_bg</item>
    <item name="android:navigationBarColor">@color/terminal_bg</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowLightNavigationBar">false</item>
    <item name="colorPrimary">@color/terminal_green</item>
    <item name="colorControlActivated">@color/terminal_green</item>
    <item name="android:textColorHint">@color/terminal_fg_dim</item>
    <item name="android:colorAccent">@color/terminal_green</item>
  </style>

  <style name="AppTheme" parent="Base.AppTheme" />

  <style name="ToolbarPill">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:background">@drawable/bg_pill</item>
    <item name="android:fontFamily">@font/jetbrains_mono</item>
    <item name="android:paddingStart">12dp</item>
    <item name="android:paddingEnd">12dp</item>
    <item name="android:paddingTop">5dp</item>
    <item name="android:paddingBottom">5dp</item>
    <item name="android:textColor">@color/terminal_fg</item>
    <item name="android:textSize">12sp</item>
    <item name="android:gravity">center</item>
  </style>

  <style name="TermKey">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_marginStart">2dp</item>
    <item name="android:layout_marginEnd">2dp</item>
    <item name="android:layout_marginTop">4dp</item>
    <item name="android:layout_marginBottom">4dp</item>
    <item name="android:background">@drawable/bg_key</item>
    <item name="android:fontFamily">@font/jetbrains_mono</item>
    <item name="android:paddingStart">12dp</item>
    <item name="android:paddingEnd">12dp</item>
    <item name="android:paddingTop">6dp</item>
    <item name="android:paddingBottom">6dp</item>
    <item name="android:textColor">@color/terminal_fg</item>
    <item name="android:textSize">12sp</item>
    <item name="android:gravity">center</item>
  </style>
</resources>
